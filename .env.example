# ── MongoDB ──────────────────────────────────────────────────────
MONGODB_URI=
DATABASE_NAME=finsentry

# ── JWT / Auth ───────────────────────────────────────────────────
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Google OAuth ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# ── External API Keys ───────────────────────────────────────────
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Redis & Celery (FinSentry Self-Contained) ─────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ── Agent Orchestration ──────────────────────────────────────────
AGENT_DEFAULT_TIMEOUT_SECONDS=300
AGENT_MAX_RETRIES=3
AGENT_RETRY_BACKOFF_SECONDS=2.0

# ── Shared LLM Configuration ─────────────────────────────────────
DEFAULT_LLM_PROVIDER=groq
DEFAULT_LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# ── CORS ─────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Cloudflare R2 Object Storage (Private) ─────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=finsentry-documents
R2_REGION=auto
R2_ENDPOINT_URL=

# ── Deployment (Phase 2H) ───────────────────────────────────
APP_ENV=development
# GATEWAY_PORT=80