# ============================================================================
# FinSentry AI — backend environment template
# ----------------------------------------------------------------------------
# Copy to backend/.env and fill in real values. NEVER commit backend/.env.
# All keys below are read by backend/core/config.py (pydantic Settings).
# Placeholder values are safe/non-secret. Do not paste real credentials here.
# ============================================================================

# ── Application ──────────────────────────────────────────────────
APP_NAME=FinSentry AI
APP_VERSION=1.0.0
# APP_ENV: development | staging | production
APP_ENV=development
# DEBUG must be a boolean (true/false). Leave false outside local dev.
DEBUG=false

# ── MongoDB ──────────────────────────────────────────────────────
# Required. e.g. mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_URI=
DATABASE_NAME=finsentry
# Optional override for local object/report storage root.
# STORAGE_LOCAL_DIR=

# ── JWT / Auth ───────────────────────────────────────────────────
# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Google OAuth ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# In production set this to your deployed callback URL.
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# ── LLM providers ────────────────────────────────────────────────
# Ollama Cloud (default provider)
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b-cloud
# Other provider API keys (fill the ones you use)
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Shared LLM configuration ─────────────────────────────────────
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LLM_MODEL=gpt-oss:120b-cloud
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# ── LLM fallback chain ───────────────────────────────────────────
LLM_FALLBACK_ENABLED=true
LLM_PRIMARY_PROVIDER=ollama
LLM_PRIMARY_MODEL=gpt-oss:120b-cloud
LLM_OLLAMA_MODEL=gpt-oss:120b-cloud
LLM_GOOGLE_MODEL=gemini-2.5-flash
LLM_CLAUDE_MODEL=claude-3-5-sonnet-latest
LLM_GROQ_MODEL=llama-3.3-70b-versatile
LLM_MAX_RETRIES_PER_PROVIDER=1
LLM_RETRY_BACKOFF_SECONDS=0.5
LLM_PROVIDER_TIMEOUT_SECONDS=30

# ── Agent orchestration ──────────────────────────────────────────
AGENT_DEFAULT_TIMEOUT_SECONDS=600
AGENT_MAX_RETRIES=3
AGENT_RETRY_BACKOFF_SECONDS=2.0

# ── Observability (optional) ─────────────────────────────────────
OBSERVABILITY_ENABLED=true
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=finsentry-research-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
PROMPT_LOGGING_ENABLED=true
TOKEN_TRACKING_ENABLED=true

# ── Redis & Celery ───────────────────────────────────────────────
# Either set REDIS_HOST/PORT/PASSWORD/DB, or set REDIS_URL directly.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=
# Default to the Redis URL above if left empty.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ── Document ingestion limits ────────────────────────────────────
STORAGE_DIR=uploads
MAX_DOCUMENT_SIZE_BYTES=26214400
MAX_DOCUMENT_PAGES=100
DEFAULT_CHUNK_SIZE=1000
DEFAULT_CHUNK_OVERLAP=150

# ── Cloudflare R2 object storage (optional) ──────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=finsentry-documents
R2_REGION=auto
# Auto-derived from R2_ACCOUNT_ID if left empty.
R2_ENDPOINT_URL=

# ── Locked PDF encryption ────────────────────────────────────────
# Optional. If empty, derived from JWT_SECRET_KEY. Encrypts the per-report
# PDF password at rest. Never commit a real value.
PDF_SECRET_KEY=

# ── SMTP / Email (backend only — NEVER exposed to the frontend) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=FinSentry AI
SMTP_USE_TLS=true

# ── Malware scanning (optional; ClamAV) ──────────────────────────
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_ENABLED=false
# If scanning is enabled and the scanner is unreachable, fail closed (reject).
SCANNER_FAIL_CLOSED=true

# ── Upload rate limiting ─────────────────────────────────────────
UPLOAD_RATE_LIMIT_REQUESTS=10
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60

# ── CORS ─────────────────────────────────────────────────────────
# FRONTEND_URL is always allowed. Add extra origins as a comma-separated list.
FRONTEND_URL=http://localhost:5173
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
